# Server-only. Never expose these values in browser code.
GROQ_API_KEY=gsk_your_key_here

# Operator gate for the public ForgePair UI. Use a long random value.
# The browser keeps it only in memory for the current page session.
FORGEPAIR_ACCESS_KEY=replace_with_a_long_random_operator_key

# Controlled GitHub mode. Use a fine-grained token scoped only to the repositories below.
# Required repository permissions for opening PRs: Contents read/write and Pull requests read/write.
GITHUB_AGENT_TOKEN=github_fine_grained_token_here
GITHUB_ALLOWED_REPOS=owner/repo,owner/second-repo

# Recommended starting models (configurable; no model IDs are hardcoded in the UI logic).
DEV_MODEL=qwen/qwen3.6-27b
REVIEW_MODEL=openai/gpt-oss-120b

# Agent loop limits
MAX_DEV_TURNS=18
MAX_REVIEW_CYCLES=2
MAX_COMPACT_REVIEW_CYCLES=2
HOST=0.0.0.0
PORT=3000
