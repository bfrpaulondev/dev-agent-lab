# Server-only. Never expose this value in browser code.
GROQ_API_KEY=gsk_your_key_here

# Recommended starting models (configurable; no model IDs are hardcoded in the UI logic).
DEV_MODEL=qwen/qwen3.6-27b
REVIEW_MODEL=openai/gpt-oss-120b

# Agent loop limits
MAX_DEV_TURNS=18
MAX_REVIEW_CYCLES=2
HOST=0.0.0.0
PORT=3000
